# ContinuityStudio Agent Configuration
PORT=8080
DATA_PATH=data

# Google Cloud / Gemini Model Configuration
# Available models: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Local Chroma DB connection (optional; built-in local vector fallback handles offline)
CHROMA_URL=http://localhost:8000
