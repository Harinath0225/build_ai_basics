# ContinuityStudio Agent Configuration
PORT=8080
DATA_PATH=data

# Google Cloud / Gemini Model Configuration
# Available models: gemini-3.6-flash, gemini-3.5-flash, gemini-3.8-flash, gemini-4-argon
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Local Chroma DB connection (optional; built-in local vector fallback handles offline)
CHROMA_URL=http://localhost:8000
